# مرحلة تشغيل الموقع على الخادم ("preview" أو "production")
SITE_STAGE=

# مرحلة تشغيل الموقع العامة للعميل ("preview" أو "production")
NEXT_PUBLIC_SITE_STAGE=

# تعطيل عرض مسودات المقالات في وضع المعاينة عند الضبط على "true"
DISABLE_PREVIEW_DRAFTS=

# إعدادات ربط قاعدة بيانات وتخزين Supabase للوحة الإدارة
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# مفتاح تشفير جلسات لوحة الإدارة (HMAC-SHA256)
ADMIN_SESSION_SECRET=

# رمز اختياري لحماية إنشاء أول مدير (اتركه فارغاً إن لم ترغب بقفل التهيئة الأولى برمز إضافي)
ADMIN_BOOTSTRAP_TOKEN=
